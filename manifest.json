{
  "manifest_version": 3,
  "name": "Medium Trending Radar",
  "version": "1.0.0",
  "description": "Discover trending Medium articles and high-opportunity topics ranked by claps, comments, and engagement velocity—100% local.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://medium.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; img-src 'self' data:;"
  },
  "content_scripts": [
    {
      "matches": [
        "https://medium.com/tag/*",
        "https://medium.com/"
      ],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Medium Trending Radar"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
