{
  "manifest_version": 3,
  "name": "Medium Trending Topics Finder",
  "short_name": "Medium Topics Finder",
  "version": "1.0.2",
  "description": "Discover trending Medium articles, top publications, and top writers local.",
  "homepage_url": "https://medium-trending-topics-finder.vercel.app/",
  "author": "Medium Trending Topics Finder Team",
  "permissions": [
    "storage"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; img-src 'self' data:;"
  },
  "content_scripts": [
    {
      "matches": [
        "https://medium.com/tag/*",
        "https://medium.com/"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Medium Trending Topics Finder"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}